<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #181A1F; -fx-background: #181A1F;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.goierri.lecturesync.desktop.controllers.AudioArchiveController">
   <content>
      <VBox spacing="20.0" style="-fx-padding: 24;">
         <children>
            <!-- Header -->
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F0F3F6;" text="Classroom Audio Archive &amp; Recordings" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #9DA5B4;" text="Manage 41.5 hours of transcribed Opus classroom recordings synced with SQLite." />
               </children>
            </VBox>

            <!-- Active Audio Player Card -->
            <VBox spacing="14.0" style="-fx-background-color: #21252B; -fx-border-color: #2E333D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <Button fx:id="btnPlayPause" mnemonicParsing="false" style="-fx-background-color: #7F52FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 6;" text="▶ Play" />
                        <VBox spacing="2.0">
                           <children>
                              <Label fx:id="lblNowPlayingTitle" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F0F3F6;" text="Kotlin Multiplatform Concurrency &amp; StateFlow" />
                              <Label fx:id="lblNowPlayingMeta" style="-fx-font-size: 12px; -fx-text-fill: #9DA5B4;" text="Prof. Martinez · Recorded Today 10:14 AM" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSpeedToggle" mnemonicParsing="false" style="-fx-background-color: #2B303C; -fx-text-fill: #38BDF8; -fx-border-color: #38BDF8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12;" text="1.5x Speed" />
                     </children>
                  </HBox>

                  <!-- Waveform Seekbar -->
                  <VBox spacing="6.0">
                     <children>
                        <ProgressBar fx:id="prgAudioPlayback" maxWidth="1.7976931348623157E308" prefHeight="8.0" progress="0.32" />
                        <HBox>
                           <children>
                              <Label fx:id="lblCurrentTime" style="-fx-font-family: monospace; -fx-text-fill: #38BDF8; -fx-font-size: 11px;" text="00:24:18" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblTotalDuration" style="-fx-font-family: monospace; -fx-text-fill: #717886; -fx-font-size: 11px;" text="01:14:20" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Table of Archived Recordings -->
            <VBox spacing="10.0" style="-fx-background-color: #21252B; -fx-border-color: #2E333D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
               <children>
                  <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #F0F3F6;" text="Recorded Audio Library" />
                  <TableView fx:id="tblAudioArchive" prefHeight="340.0">
                     <columns>
                        <TableColumn fx:id="colAudioTitle" prefWidth="300.0" text="Topic / Title" />
                        <TableColumn fx:id="colAudioSubject" prefWidth="180.0" text="Subject" />
                        <TableColumn fx:id="colAudioDuration" prefWidth="120.0" text="Duration" />
                        <TableColumn fx:id="colAudioDate" prefWidth="160.0" text="Recorded Date" />
                        <TableColumn fx:id="colAudioAction" prefWidth="120.0" text="Playback" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
