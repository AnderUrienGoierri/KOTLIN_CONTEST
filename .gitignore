# =============================================================================
# LectureSync AI - .gitignore (Kotlin Multiplatform + JavaFX + Android)
# =============================================================================

# Gradle & Build Outputs
.gradle/
build/
target/
bin/
out/
!gradle/wrapper/gradle-wrapper.jar

# Compiled Bytecode & Archives
*.class
*.jar
!gradle-wrapper.jar
*.war
*.ear

# Android Specific Artifacts
*.apk
*.aab
*.dex
captures/
.externalNativeBuild/
.cxx/

# SQLite & Runtime Database Files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
lecturesync.db

# IntelliJ IDEA & Android Studio
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Visual Studio / VS Code
.vscode/
.vs/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs & Diagnostics
*.log
hs_err_pid*
replay_pid*

# Secrets, Environment & API Keys (Security Gate)
.env
*.env
*.env.*
local.properties
*.key
*.keystore
*.jks
*.token
