<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="980.0" spacing="24.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.goierri.lecturesync.desktop.controllers.FlashcardsController">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" maxWidth="640.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="card-title" style="-fx-font-size: 20px;" text="Spaced Repetition Study Deck" />
                  <Label styleClass="card-subtitle" text="SuperMemo SM-2 algorithm scheduling." />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Main Flip Card Container -->
      <VBox fx:id="cardFlipContainer" alignment="CENTER" maxWidth="640.0" prefHeight="320.0" spacing="16.0" styleClass="card-panel">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblCardBadge" styleClass="badge-purple" text="Card 1 of 2 (Box 1)" />
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Label fx:id="lblCardQuestion" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F0F3F6; -fx-text-alignment: center;" text="What does Dispatchers.JavaFx guarantee?" textAlignment="CENTER" wrapText="true" VBox.vgrow="ALWAYS" />

            <Label fx:id="lblCardAnswer" style="-fx-font-size: 14px; -fx-text-fill: #9DA5B4; -fx-text-alignment: center; -fx-border-color: #2E333D; -fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;" text="It schedules coroutines on the JavaFX UI Application Thread." textAlignment="CENTER" visible="false" wrapText="true" />

            <Button fx:id="btnFlipCard" mnemonicParsing="false" styleClass="btn-secondary" text="Show Answer" />
         </children>
      </VBox>

      <!-- Grade / Review Buttons -->
      <HBox alignment="CENTER" maxWidth="640.0" spacing="16.0">
         <children>
            <Button fx:id="btnMarkReview" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #E06C75;" styleClass="btn-primary" text="Again (1d)" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMarkGood" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #3574F0;" styleClass="btn-primary" text="Good (3d)" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMarkKnown" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #28A745;" styleClass="btn-primary" text="Easy (6d)" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <!-- Progress Mastery -->
      <VBox maxWidth="640.0" spacing="8.0">
         <children>
            <ProgressBar fx:id="prgMastery" maxWidth="1.7976931348623157E308" prefHeight="8.0" progress="0.5" />
            <Label fx:id="lblProgress" styleClass="card-subtitle" text="Session Progress: 50% completed" />
         </children>
      </VBox>
   </children>
</VBox>
